{
  "name": "velope-ott-reference-app-samsung",
  "version": "1.4.2",
  "private": true,
  "license": "MIT",
  "description": "Reference streaming app for Samsung TVs (Tizen): SolidJS on the Lightning 3 renderer, with Samsung remote keys, video previews and an on-screen player, packaged as a Tizen web app",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "tizen": "sh scripts/tizen.sh",
    "tizen:package": "sh scripts/tizen.sh package"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@solidtv/renderer": "1.9.3",
    "@solidtv/solid": "1.6.3",
    "hls.js": "^1.7.3",
    "shaka-player": "^4.16.50",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.10"
  },
  "packageManager": "pnpm@10.34.5"
}
