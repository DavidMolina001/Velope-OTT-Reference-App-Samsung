# TMDB v3 API key (32-char hex). Get a free one: https://developer.themoviedb.org/docs/getting-started
# Required: without it the app shows its error screen. Read at build time by Vite and exposed as
# import.meta.env.VITE_TMDB_API_KEY; the value ends up in the bundle, which is why .env is ignored.
VITE_TMDB_API_KEY=
# (The un-prefixed name TMDB_API_KEY works too.)

# Optional: point the app at a different TMDB-compatible host (defaults to https://api.themoviedb.org).
# Used with the mock server in tools/ for fault injection.
# VITE_TMDB_BASE_URL=https://api.themoviedb.org
